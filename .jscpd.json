{
  "format": ["python", "typescript", "tsx"],
  "minTokens": 50,
  "minLines": 5,
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.build/**",
    "**/.venv/**",
    "**/__pycache__/**",
    "**/migrations/**",
    "**/tests/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "acceptance/**"
  ],
  "absolute": true
}
