# Quaestor local dev template (ADR-0026).
#
# Pick ONE profile, save it as the matching filename, fill in real values:
#   cp backend/.env.local.example backend/.env.local.sqlite
#   cp backend/.env.local.example backend/.env.local.remote
#
# Then `just dev-local` or `just dev-real` will pick the right file.
# Never commit a filled-in copy — both `.env.local.*` are gitignored.

# --- Profile A: local SQLite (sandbox) ---
# Default for `just dev-local`. The file lives at /app/.dev-data/quaestor.db
# inside the api container, persisted via the quaestor-dev-data Docker volume.
# Your existing `.dev-data/quaestor.db` data is preserved automatically
# (named volume preserves data across `docker compose down` — no `-v`).
QUAESTOR_DB=sqlite+aiosqlite:////app/.dev-data/quaestor.db
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000

# --- Profile B: remote Postgres (production-like) ---
# For `just dev-real`. Target: Render.com Oregon (database `quaestor_production_db`).
# Set the URL below to your actual remote Postgres URL. NEVER commit a real password.
# QUAESTOR_DB=postgresql://quaestor_production_db_user:REDACTED@dpg-XXXXXXXXXXXXX-a.oregon-postgres.render.com:5432/quaestor_production_db
# COOKIE_SECURE=true  # only if fronting the app with TLS
# FRONTEND_ORIGIN=http://localhost:3000  # or your actual origin

# --- Shared (both profiles) ---
APP_TOKEN=change-me
APP_PASSWORD=change-me
SESSION_SECRET=change-me-32-chars-minimum

# --- Chat endpoint (ADR-0014) ---
LLM_PROVIDER=litellm
LLM_MODEL=anthropic/MiniMax-M3
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# ANTHROPIC_API_KEY=                  # required; never commit
CHAT_MAX_ITERATIONS=8
CHAT_REQUEST_TIMEOUT_S=120

# --- Scheduler (in-process asyncio task; ADR-0026) ---
SCHEDULER_ENABLED=1
RUN_ON_BOOT=1