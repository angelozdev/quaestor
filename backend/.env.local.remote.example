# Quaestor remote profile template (ADR-0026).
#
# Copy this to backend/.env.local.remote and fill in your real Postgres URL:
#   cp backend/.env.local.remote.example backend/.env.local.remote
#
# Then `just dev-real` will use this file. NEVER commit the filled-in copy
# (it's gitignored).

QUAESTOR_DB=postgresql://USER:PASSWORD@HOST:5432/DBNAME
COOKIE_SECURE=true
FRONTEND_ORIGIN=http://localhost:3000

# --- Shared secrets ---
APP_TOKEN=change-me
APP_PASSWORD=change-me
SESSION_SECRET=change-me-32-chars-minimum

# --- Chat endpoint (ADR-0014) ---
LLM_PROVIDER=litellm
LLM_MODEL=anthropic/MiniMax-M3
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# ANTHROPIC_API_KEY=                  # required; never commit
CHAT_MAX_ITERATIONS=8
CHAT_REQUEST_TIMEOUT_S=120

# --- Scheduler (in-process asyncio task; ADR-0026) ---
SCHEDULER_ENABLED=1
RUN_ON_BOOT=1