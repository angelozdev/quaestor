# Quaestor local-Postgres production profile template (ADR-0030).
#
# Copy this to backend/.env.local.postgres and fill in real values:
#   cp backend/.env.local.postgres.example backend/.env.local.postgres
#
# Then `just dev-prod` runs the full stack against the local Postgres
# container (compose profile "pg"). NEVER commit the filled-in copy
# (it's gitignored). Backups: `just backup` → iCloud Drive.

# Local Postgres container (service "db" in docker-compose.yml).
# Password must match POSTGRES_PASSWORD below.
QUAESTOR_DB=postgresql://quaestor:CHANGE-ME@db:5432/quaestor
POSTGRES_USER=quaestor
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=quaestor

COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000

# --- Shared secrets ---
APP_TOKEN=change-me
APP_PASSWORD=change-me
SESSION_SECRET=change-me-32-chars-minimum

# --- Chat endpoint (ADR-0014) ---
LLM_PROVIDER=litellm
LLM_MODEL=anthropic/MiniMax-M3
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# ANTHROPIC_API_KEY=                  # required; never commit
CHAT_MAX_ITERATIONS=8
CHAT_REQUEST_TIMEOUT_S=120

# --- Scheduler (in-process asyncio task; ADR-0026) ---
SCHEDULER_ENABLED=1
RUN_ON_BOOT=1
