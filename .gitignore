# Python
__pycache__/
*.py[cod]
.venv/
.python-version

# python / quaestor
__pycache__/
*.pyc
.venv/
backend/.venv/
.pytest_cache/
uv.lock

# Node / Next
node_modules/
.next/
out/

# OS
.DS_Store

# MCP — keep template .mcp.json committed, local overrides stay private
.mcp.local.json

# Deploy artifacts / state
.env
.env.*
!.env.example
!.env.local.example
!.env.local.remote.example
!.env.local.postgres.example
frontend/.next/

# AI agent workspace (oh-my-opencode orchestration state).
# https://github.com/code-yeongyu/oh-my-openagent — `.omo/` is tool state,
# regenerated each session. `.omo/rules/` is the project-shared rules
# directory and IS tracked.
.omo/*
!.omo/rules/
!.omo/rules/**

# One-off importer artifacts (work-in-progress; not source)
backend/migrate_lunchmoney.sql

# Personal financial data export (purged from history; never re-commit)
lunchmoney-transactions.csv

# Local SQLite databases (dev artifact; row data lives in quaestor-dev-data Docker volume per ADR-0026)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# DAE build artifacts (spec IR, generated pipelines)
.build/

# The mutation sweep copies its target here so a kill signal cannot lose the source.
*.py.orig

# Design-tool state: a hook cache, the served decision pages and their answers, and
# a four-line live-mode config any run regenerates. Machine-local, not source — and
# a one-machine project (PRODUCT.md) has no second clone that would want it.
.impeccable/
